<%- include('./templates/header.ejs') %>

<% for (const user of users) { %>
    <div class="user-card">
        <p>Username: <span class="admin-field"><%= user.username %></span></p>
        <p>First Name: <span class="admin-field"><%= user.firstname %></span></p>
        <p>Last Name: <span class="admin-field"><%= user.lastname %></span></p>
        <p>Is a member: <span class="admin-field"><%= user.member %></span></p>
        <p>is Admin: <span class="admin-field"><%= user.isadmin %></span></p>
        <form id="admin-checkbox" action="/admin" method="POST">
            <input type="hidden" name="userId" value="<%= user.id %>">
            <% if (user.isadmin) { %>
                <input type="checkbox" id="admin" name="admin" checked />
            <% } else { %>
                <input type="checkbox" id="admin" name="admin" />
            <% } %>
            <label for="admin">is admin</label>
            <button>Apply</button>
        </form>
    </div>
<% } %>

<%- include('./templates/footer.ejs') %>