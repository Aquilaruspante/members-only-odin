<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>Only Members Message Board</title>
</head>
<body>
    <div class="header-container">
        <header class="page-header">
            <h1><a href="/messages">Inner Circle</a></h1>
            <nav>
                <a class="new-message" href="/messages/new">New</a>
                <% if (locals.user) { %>
                    <a href="/user/logout">Logout</a>
                    <p class="user-nav"><%= user.username %></p>
                <% } else { %>
                    <a href="/user/login">Login</a>
                    <a href="/user/register">Sign up</a>
                <% } %>
            </nav>
        </header>
    </div>
<main>
    
