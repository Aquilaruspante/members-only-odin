<%- include('./templates/header.ejs') %>


    <% if (sessionMessages) { %>
        <p class="<%= sessionMessages.type %> flash-message"><%= sessionMessages.message %></p>
    <% } %>
    <% for (const message of messages) { %>
        <div class="message-card">
            <% if (user && user.member) { %>
                <h2 class="card-owner card-section">From <%= message.user.username %>:</h2>
            <% } else { %>
                <h2 class="card-owner card-section">From <span class="error">CLASSIFIED:</span></h2>
            <% } %>
            <p class="card-body card-section"><%= message.body %></p>
            <h3 class="card-footer"><%= message.date %></h3>
        </div>
    <% } %>

<%- include('./templates/footer.ejs') %>