<%- include('./templates/header.ejs') %>

<main>
    <% if (user) { %>
        <p><%= user.username %></p>
    <% } %>
    <% if (flash) { %>
        <p class=`${flash.type}`><%= flash.message %></p>
    <% } %>
    <% if (sessionMessages) { %>
        <p class="<%= sessionMessages.type %>"><%= sessionMessages.message %></p>
    <% } %>
    <% for (const message of messages) { %>
        <div class="message-card">
            <p><%= message.body %></p>
            <p><%= message.date %></p>
        </div>
    <% } %>
</main>

<%- include('./templates/footer.ejs') %>