<%- include('./templates/header.ejs') %>


    <% if (sessionMessages) { %>
        <p class="<%= sessionMessages.type %> flash-message"><%= sessionMessages.message %></p>
    <% } %>
    <% if (locals.user && !locals.user.member) { %>
        <form id="link-container" action="/members">
            <button id="membership-link">APPLY FOR MEMBERSHIP</button>
        </form>
    <% } %>
    <% for (const message of messages) { %>
        <div class="message-card">
            <% if (locals.user && locals.user.member) { %>
                <h2 class="card-owner card-section">From <span class="author"><%= message.user.username %>:</span></h2>
            <% } else { %>
                <h2 class="card-owner card-section">From <span class="error">CLASSIFIED:</span></h2>
            <% } %>
            <p class="card-body card-section"><%= message.body %></p>
            <h3 class="card-footer"><%= message.date %></h3>
            <% if (locals.user && locals.user.isadmin) { %>
                <form class="delete-form" action="/messages/<%= message.id %>?_method=DELETE" method="POST">
                    <button>Delete</button>
                </form>
            <% } %>
        </div>
    <% } %>

<%- include('./templates/footer.ejs') %>